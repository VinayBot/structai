# Copy this file to .env and fill in real values. Never commit .env.

ENV=development

# --- Auth ---
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MIN=15
JWT_REFRESH_EXPIRE_DAYS=7

# --- GitHub OAuth login (optional) ---
# Register an OAuth App at https://github.com/settings/developers with callback
# URL matching GITHUB_OAUTH_REDIRECT_URI below. Leave blank to disable - the
# login button then returns a clean 503 instead of a crash. See docs/API.md.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:5173/auth/github/callback

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./data/structai.db

# --- Model providers ---
# Local, no key needed. Detected at runtime via GET {OLLAMA_BASE_URL}/api/tags.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_FAST_MODEL=qwen2.5:7b-instruct
OLLAMA_SMART_MODEL=qwen2.5:7b-instruct

# Free-tier API. Get a key at https://console.groq.com — paste it below, never log it.
GROQ_API_KEY=
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_SMART_MODEL=openai/gpt-oss-120b

# Shared httpx connection pool (app/core/http_client.py) used by every provider -
# defaults match httpx's own built-in defaults.
HTTP_MAX_CONNECTIONS=100
HTTP_MAX_KEEPALIVE_CONNECTIONS=20

# Optional per-model cost estimation (app/gateway/router.py::estimate_cost_usd) - JSON
# object keyed "{provider}:{model}" -> {"prompt": $ per 1K tokens, "completion": $ per
# 1K tokens}. No price is ever hardcoded in application logic; leaving this blank (or
# omitting a provider/model, e.g. local Ollama) means that usage costs 0. Example:
#   TOKEN_PRICE_TABLE={"groq:openai/gpt-oss-20b": {"prompt": 0.0001, "completion": 0.0001}}
TOKEN_PRICE_TABLE={}

# --- Structured answers ---
STRUCTURED_MAX_ATTEMPTS=3
STRUCTURED_TIMEOUT_SECONDS=30.0

# --- Guardrails / abuse limits ---
RATE_LIMIT_PER_MIN=20
DAILY_QUOTA_USER=30
# Per-IP, shared across register/login/refresh/github-callback - these take a
# credential before a user is authenticated, so RATE_LIMIT_PER_MIN above (keyed
# by user id) doesn't cover them.
AUTH_RATE_LIMIT_PER_MIN=10
# memory (default, single-instance only) | redis (shared across instances,
# requires the optional 'redis' extra: `uv sync --extra redis`). See
# app/guardrails/rate_limit.py. `docker-compose --profile redis up` runs a local
# Redis for this.
RATE_LIMIT_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
# redact (default, mask PII in-place) | block (reject the request/output outright)
PII_MODE=redact
# MX/A-record reachability check on registration email domains, 3s timeout by default,
# fails open (warns, doesn't block) on a timeout/network error - only a confirmed
# NXDOMAIN or a domain with no MX/A/AAAA at all is rejected outright.
EMAIL_CHECK_MX=true
EMAIL_CHECK_MX_TIMEOUT_SECONDS=3.0
# Optional path to a newline-separated file of extra disposable-email domains to
# merge with the built-in list (one domain per line, '#' comments allowed). Blank = none.
EMAIL_DISPOSABLE_DOMAINS_FILE=

# --- Persistence / uploads ---
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_BYTES=10485760
# Comma-separated allowlist; a content-type not on this list is rejected with
# 415 unsupported_media_type before it's ever written to disk.
ALLOWED_UPLOAD_CONTENT_TYPES=text/plain,text/csv,text/markdown,application/json,application/pdf,image/png,image/jpeg,image/gif,image/webp

# --- Observability ---
# Optional OpenTelemetry span export (app/core/otel.py), disabled (the in-process
# tracer at GET /traces always works regardless) unless this is set AND the
# optional 'otel' extra is installed: `uv sync --extra otel`. Points at an
# OTLP/HTTP endpoint, e.g. http://localhost:4318 for the otel-collector profile
# (`docker-compose --profile otel up`).
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Web/CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# --- MCP server ---
# Credentials the MCP server (app/mcp/server.py) acts as. Issue a pair with:
#   .venv/bin/python3 scripts/mcp_issue_token.py --email you@example.com --password yourpassword --register
# See docs/MCP_SERVER.md for Claude Desktop/Code setup.
MCP_ACCESS_TOKEN=
MCP_REFRESH_TOKEN=

# --- Build info (GET /health) ---
# Leave blank to auto-detect via `git rev-parse --short HEAD` / process start time.
# Set these in environments without a .git directory (e.g. a built container image).
GIT_COMMIT=
BUILD_TIME=
